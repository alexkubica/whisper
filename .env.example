# OpenAI credentials are server-only. The admin key is optional and is used only
# for organization cost reporting.
OPENAI_API_KEY="replace-with-openai-api-key"
OPENAI_ADMIN_KEY="replace-with-openai-admin-key"
OPENAI_TRANSCRIBE_MODEL="gpt-4o-mini-transcribe"

# Supabase browser auth and private server/storage access.
NEXT_PUBLIC_SUPABASE_URL="https://project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="replace-with-publishable-key"
SUPABASE_SECRET_KEY="replace-with-secret-key"
SUPABASE_STORAGE_BUCKET="recordings"
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Comma-separated exact Google emails. Access fails closed when unset.
AUTHORIZED_EMAILS="owner@example.com"

# The public waitlist endpoint is disabled unless explicitly enabled.
WAITLIST_ENABLED="false"
